ics stay outside timed automata.\r\n// Generation mode: with_observers.\r\n// Layout mode: readable.\r\n// Negative scenarios disabled for this generated model.\r\nconst int D_meas = 5;\r\nconst int D_sig = 5;\r\nconst int D_sense = 5;\r\nconst int D_report = 5;\r\nconst int D_BM = 5;\r\nconst int D_child = 5;\r\nconst int D_net = 5;\r\nconst int T_meas = 5;\r\nconst int J_meas = 1;\r\nconst int T_report = 5;\r\nconst int J_SSB = 1;\r\nconst int tau_SSB = 4;\r\n\r\nconst int SCENARIO_NORMAL = 0;\r\nconst int SCENARIO_COMM_DEGRADED = 1;\r\nconst int SCENARIO_SENSING_DEGRADED = 2;\r\nconst int SCENARIO_JOINT_DEGRADED = 3;\r\nint[0,3] env_scenario = SCENARIO_NORMAL;\r\n\r\nclock c_meas, c_sig, c_sense, c_report, c_rec, c_ssb;\r\nclock aos_bs, aos_ctrl, c_env, c_net;\r\nclock c_obs_sense, c_obs_fresh, c_obs_beam;\r\nclock c_obs_channel, c_obs_signal, c_obs_sensing, c_obs_phy;\r\n\r\ntypedef int[0,4] WaveformT;\r\nconst int W_OFDM = 0;\r\nconst int W_OTFS = 1;\r\nconst int W_AFDM = 2;\r\nconst int W_SC = 3;\r\nconst int W_OTHER = 4;\r\nWaveformT W = W_OFDM;\r\n\r\nchan beam_cmd, controller_report_delivered, extra_ssb_cmd, handover_assist_cmd, mac_report_delivered, measure_tick, new_beam_confirmed, payload_sensing_config, pilot_config, power_cmd, prs_config, recovery_cmd, sensing_mode_cmd, ssb_burst_config, waveform_config;\r\nbroadcast chan aos_ctrl_expired, beam_failure, beam_locked, beam_misaligned, beam_report, beam_restored, blockage_detected, channel_degraded, channel_report, contract_violation_bm, contract_violation_ch, contract_violation_ph, contract_violation_sig, contract_violation_sq, degradation_event, handover_hint, mobility_alert, multipath_alert, phy_failure, phy_kpi_report, phy_outage, recovery_event, recovery_start, sensing_degraded, sensing_failure, sensing_report, sensing_success, signal_degraded, signal_report, target_detected;\r\n\r\n// === A_CH: Channel classifier ===\r\n// === A_SIG: Signal classifier ===\r\n// === A_BM: Beam management ===\r\n// ==