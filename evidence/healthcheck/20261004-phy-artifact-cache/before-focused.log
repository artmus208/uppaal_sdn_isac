URCESHARECLASS_STARVED = 2;\r\nResourceShareClassT ResourceShareClass = RESOURCESHARECLASS_OK;\r\n\r\ntypedef int[0,2] MisClassT;\r\nconst int MISCLASS_OK = 0;\r\nconst int MISCLASS_WARN = 1;\r\nconst int MISCLASS_CRITICAL = 2;\r\nMisClassT MisClass = MISCLASS_OK;\r\n\r\ntypedef int[0,2] BMOverheadClassT;\r\nconst int BMOVERHEADCLASS_OK = 0;\r\nconst int BMOVERHEADCLASS_HIGH = 1;\r\nconst int BMOVERHEADCLASS_EXCESSIVE = 2;\r\nBMOverheadClassT BMOverheadClass = BMOVERHEADCLASS_OK;\r\n\r\ntypedef int[0,5] ChannelClassT;\r\nconst int CHANNELCLASS_NOMINAL = 0;\r\nconst int CHANNELCLASS_INTERFERENCE_LIMITED = 1;\r\nconst int CHANNELCLASS_MOBILITY_LIMITED = 2;\r\nconst int CHANNELCLASS_MULTIPATH_LIMITED = 3;\r\nconst int CHANNELCLASS_BLOCKAGE = 4;\r\nconst int CHANNELCLASS_OUTAGE = 5;\r\nChannelClassT ChannelClass = CHANNELCLASS_NOMINAL;\r\n\r\ntypedef int[0,4] SignalClassT;\r\nconst int SIGNALCLASS_NOMINAL = 0;\r\nconst int SIGNALCLASS_PILOT_BASED = 1;\r\nconst int SIGNALCLASS_PAYLOAD_ASSISTED = 2;\r\nconst int SIGNALCLASS_RECONFIGURING = 3;\r\nconst int SIGNALCLASS_LIMITED = 4;\r\nSignalClassT SignalClass = SIGNALCLASS_NOMINAL;\r\n\r\ntypedef int[0,7] BeamClassT;\r\nconst int BEAMCLASS_SEARCH = 0;\r\nconst int BEAMCLASS_TRACK = 1;\r\nconst int BEAMCLASS_LOCKED = 2;\r\nconst int BEAMCLASS_PREDICT = 3;\r\nconst int BEAMCLASS_MISALIGNED = 4;\r\nconst int BEAMCLASS_RECOVERING = 5;\r\nconst int BEAMCLASS_HO_ASSIST = 6;\r\nconst int BEAMCLASS_FAILED = 7;\r\nBeamClassT BeamClass = BEAMCLASS_SEARCH;\r\n\r\ntypedef int[0,7] SensingStateT;\r\nconst int SENSINGSTATE_SENSINGQOSOK = 0;\r\nconst int SENSINGSTATE_PROBABILITYLIMITED = 1;\r\nconst int SENSINGSTATE_FALSEALARMLIMITED = 2;\r\nconst int SENSINGSTATE_ACCURACYLIMITED = 3;\r\nconst int SENSINGSTATE_FRESHNESSLIMITED = 4;\r\nconst int SENSINGSTATE_COVERAGELIMITED = 5;\r\nconst int SENSINGSTATE_CAPACITYLIMITED = 6;\r\nconst int SENSINGSTATE_SENSINGFAILURE = 7;\r\nSensingStateT SensingState = SENSINGSTATE_SENSINGQOSOK;\r\n\r\ntype